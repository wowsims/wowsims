{
  "name": "@wowsims/styleguide",
  "author": "WoWSims Developers",
  "version": "1.0.0",
  "description": "WoWSims Components styleguide",
  "engines": {
    "yarn": "Please use npm",
    "node": ">= 9"
  },
  "volta": {
    "node": ">= 18",
    "npm": ">= 9"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "format": "npm run lint:fix && npm run prettier:fix",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
    "lint:js": "npx eslint \"./ui/**/*.{js,jsx,ts,tsx}\"",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:css": "stylelint \"./ui/**/*.scss\"",
    "lint:css:fix": "npm run lint:css -- --fix",
    "lint:json": "npx eslint \"./{ui,jsonschema}/**/*.json\"",
    "lint:json:fix": "npm run lint:json -- --fix",
    "prettier": "npx prettier \"./ui/**/*.{js,jsx,ts,tsx,scss,css,json}\" --check",
    "prettier:fix": "npm run prettier -- --write",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.0.10",
    "@storybook/addon-interactions": "^8.0.10",
    "@storybook/addon-links": "^8.0.10",
    "@storybook/addon-onboarding": "^8.0.10",
    "@storybook/blocks": "^8.0.10",
    "@storybook/manager-api": "^8.0.10",
    "@storybook/react-vite": "^8.0.10",
    "@storybook/test": "^8.0.10",
    "@storybook/theming": "^8.0.10",
    "@types/react": "^18.3.1",
    "@wowsims/assets": "*",
    "@wowsims/config": "*",
    "@wowsims/constants": "*",
    "@wowsims/ui": "*",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  }
}
