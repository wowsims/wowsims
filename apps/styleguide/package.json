{
  "name": "@wowsims/styleguide",
  "author": "WoWSims Developers",
  "version": "1.0.0",
  "description": "WoWSims Components styleguide",
  "engines": {
    "npm": "Please use Yarn",
    "node": ">= 18"
  },
  "volta": {
    "node": ">= 18",
    "npm": ">= 9"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "format": "yarn lint:fix && yarn prettier:fix",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:fix": "yarn lint:js:fix && yarn lint:css:fix",
    "lint:js": "npx eslint \"./ui/**/*.{js,jsx,ts,tsx}\"",
    "lint:js:fix": "yarn lint:js -- --fix",
    "lint:css": "stylelint \"./ui/**/*.scss\"",
    "lint:css:fix": "yarn lint:css -- --fix",
    "lint:json": "npx eslint \"./{ui,jsonschema}/**/*.json\"",
    "lint:json:fix": "yarn lint:json -- --fix",
    "prettier": "npx prettier \"./ui/**/*.{js,jsx,ts,tsx,scss,css,json}\" --check",
    "prettier:fix": "yarn prettier -- --write",
    "type-check": "tsc"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.3.4",
    "@storybook/addon-essentials": "^8.0.10",
    "@storybook/addon-interactions": "^8.0.10",
    "@storybook/addon-links": "^8.0.10",
    "@storybook/addon-onboarding": "^8.0.10",
    "@storybook/blocks": "^8.0.10",
    "@storybook/html-vite": "^8.0.10",
    "@storybook/manager-api": "^8.0.10",
    "@storybook/test": "^8.0.10",
    "@storybook/theming": "^8.0.10",
    "@wowsims/assets": "*",
    "@wowsims/config": "*",
    "@wowsims/constants": "*",
    "@wowsims/ui": "*",
    "clsx": "^2.1.1",
    "sass": "^1.77.1",
    "storybook": "^8.0.10",
    "typescript": "^5.3.0",
    "vite": "^5.2.11",
    "vite-multiple-assets": "^1.2.10",
    "vite-plugin-checker": "^0.6.4",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  }
}
