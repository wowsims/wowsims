{
  "name": "@wowsims/core",
  "author": "WoWSims Developers",
  "version": "1.0.0",
  "description": "WoWSims NPM Package",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "type-check": "tsc",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "ui": "npm --workspace=@wowsims/ui",
    "assets": "npm --workspace=@wowsims/assets",
    "styleguide": "npm --workspace=@wowsims/styleguide"
  },
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wowsims/wowsims.git"
  },
  "bugs": {
    "url": "https://github.com/wowsims/wowsims/issues"
  },
  "homepage": "https://github.com/wowsims/wowsims#readme",
  "devDependencies": {
    "@chromatic-com/storybook": "^1.3.4",
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@wowsims/config": "*",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^0.8.0",
    "prettier": "^3.2.5",
    "rollup": "^4.17.2",
    "rollup-plugin-scss": "^4.0.0",
    "storybook": "^8.0.10",
    "turbo": "^1.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-multiple-assets": "^1.2.10",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "dependencies": {
    "bootstrap": "^5.3.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
