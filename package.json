{
	"name": "@wowsims/core",
	"author": "WoWSims Developers",
	"version": "1.0.0",
	"description": "WoWSims NPM Package",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev --parallel",
		"type-check": "tsc",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"format": "prettier --write \"**/*.{ts,tsx}\"",
		"ui": "yarn workspace @wowsims/ui",
		"assets": "yarn workspace @wowsims/assets",
		"styleguide": "yarn workspace @wowsims/styleguide"
	},
	"keywords": [],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wowsims/wowsims.git"
	},
	"bugs": {
		"url": "https://github.com/wowsims/wowsims/issues"
	},
	"homepage": "https://github.com/wowsims/wowsims#readme",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^7.8.0",
		"@typescript-eslint/parser": "^7.8.0",
		"@wowsims/config": "*",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-json": "^3.1.0",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-simple-import-sort": "^10.0.0",
		"eslint-plugin-storybook": "^0.8.0",
		"eslint-plugin-unused-imports": "^2.0.0",
		"prettier": "^3.2.5",
		"stylelint": "^15.10.3",
		"stylelint-prettier": "^4.0.2",
		"stylelint-scss": "^5.2.1",
		"turbo": "^1.13.3",
		"typescript": "^5.4.5"
	}
}
