{
	"name": "@wowsims/ui",
	"author": "WoWSims Developers",
	"version": "1.0.0",
	"description": "WoWSims Components libary",
	"engines": {
		"npm": "Please use Yarn",
		"node": ">= 18"
	},
	"volta": {
		"node": ">= 18",
		"npm": ">= 9"
	},
	"scripts": {
		"format": "yarn lint:fix && yarn prettier:fix",
		"lint": "yarn lint:js && yarn lint:css",
		"lint:fix": "yarn lint:js:fix && yarn lint:css:fix",
		"lint:js": "npx eslint \"./**/*.{js,jsx,ts,tsx}\"",
		"lint:js:fix": "yarn lint:js -- --fix",
		"lint:css": "stylelint \"./**/*.scss\"",
		"lint:css:fix": "yarn lint:css -- --fix",
		"lint:json": "npx eslint \"./**/*.json\"",
		"lint:json:fix": "yarn lint:json -- --fix",
		"prettier": "npx prettier \"./**/*.{js,jsx,ts,tsx,scss,css,json}\" --check",
		"prettier:fix": "yarn prettier -- --write",
		"type-check": "tsc"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^1.3.4",
		"@fortawesome/fontawesome-common-types": "^6.5.2",
		"sass": "^1.77.1",
		"typescript": "^5.3.0"
	},
	"dependencies": {
		"@storybook/html": "^8.1.0",
		"@storybook/test": "^8.1.0",
		"@wowsims/config": "*",
		"@wowsims/constants": "*",
		"bootstrap": "^5.3.3",
		"clsx": "^2.1.1",
		"tsx-vanilla": "^1.0.0"
	}
}
